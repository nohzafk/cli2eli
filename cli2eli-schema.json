{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "choices": {
                  "type": "array"
                },
                "description": {
                  "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": ["current-file", "current-file-relative-path", "directory", "dynamic-select"],
                    "description": "Argument type for special input handling"
                },
                "command": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "transform": {
                  "type": "string"
                }
              },
              "required": ["name"]
            }
          },
          "chain-call": {
            "type": "string"
          },
          "chain-pass": {
            "type": "boolean"
          },
          "stdin": {
            "type": "string",
            "enum": ["region", "buffer"],
            "description": "Source for stdin input. 'region' uses selected text (or entire buffer if no selection). 'buffer' always uses entire buffer content."
          }
        },
        "required": ["name", "command"]
      }
    }
  },
  "required": ["tool", "cwd", "commands"]
}
